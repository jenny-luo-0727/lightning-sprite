#!/bin/bash
# Checkpoint save/resume check on ALCF Aurora, 12 tiles per node. One node by default; pass -l select=N for N nodes:
#   qsub -A <project> -q debug [-l select=2] -v PY=<python>,OUT=<outdir>,MODEL=<local model path> examples/checkpoint.pbs
# PRECISION=bf16-mixed selects BF16. STAGE=train or STAGE=faults splits the run in two, as in checkpoint.sbatch. The
# global batch is 2 rows per rank. Storage depends on the selected model.
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N sprite-checkpoint
set -eo pipefail
# Lmod's bash init reads unset variables (ZSH_EVAL_CONTEXT), so nounset comes on only after the module load.
module load frameworks
set -u
export ZE_FLAT_DEVICE_HIERARCHY=FLAT   # one device per tile: 12 per node
cd "$PBS_O_WORKDIR"
# Install the release checkout in the worker environment for versioned results.
EX=${SPRITE_EXAMPLES:-$PBS_O_WORKDIR/examples}
[[ -d "$EX/../src/lightning_sprite" ]] && export PYTHONPATH="$EX/../src${PYTHONPATH:+:$PYTHONPATH}"
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NRANKS=$((NNODES * 12))
PRECISION=${PRECISION:-32-true}
STAGE=${STAGE:-all}
case "$STAGE" in
  all) PARTS="train faults" ;;
  train | faults) PARTS=$STAGE ;;
  *) echo "STAGE must be all, train or faults, not '$STAGE'" >&2; exit 1 ;;
esac
# One claim per part, so a second submission into the same outdir stops here instead of racing the first.
mkdir -p "$OUT"
for part in $PARTS; do mkdir "$OUT/.claim-$part"; done
ARGS=(--device xpu --model "$MODEL" --global-batch "$((2 * NRANKS))" --precision "$PRECISION")
# No per-rank ZE_AFFINITY_MASK: every rank must see all 12 tiles and selects xpu:<local rank>.
# launch <processes> <processes per node> <nodes> <arm> <role> [extra args]
launch() {
  local n=$1 ppn=$2 nodes=$3 arm=$4 role=$5
  shift 5
  mpiexec -n "$n" --ppn "$ppn" "$PY" "$EX/checkpoint_check.py" run "$arm" "$role" "$OUT" "${ARGS[@]}" \
    --world "$n" --nodes "$nodes" "$@"
}
if [[ "$STAGE" == all || "$STAGE" == train ]]; then
  for role in full twin save resume reload; do
    launch 1 1 1 single "$role"
    for arm in ddp fsdp fsdp_file; do launch "$NRANKS" 12 "$NNODES" "$arm" "$role"; done
  done
  launch "$((NRANKS / 2))" 6 "$NNODES" fsdp reshard
  for source in ddp fsdp_file; do launch 1 1 1 single export --source "$source"; done
fi
if [[ "$STAGE" == all || "$STAGE" == faults ]]; then
  for fault in drop-optimizer drop-scheduler perturb-weight; do
    launch 1 1 1 single resume --fault "$fault"
    for arm in ddp fsdp fsdp_file; do launch "$NRANKS" 12 "$NNODES" "$arm" resume --fault "$fault"; done
  done
  "$PY" "$EX/checkpoint_check.py" compare "$OUT"
fi
